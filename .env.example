# ─────────────────────────────────────────────────────────────
# SMART_BUZ — Environment Variables
# Copy to `.env.local` for development. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────
#
# Production (Vercel): set these under
#   Project → Settings → Environment Variables
# and enable them for Production, Preview and Development.
#
# IMPORTANT — `NEXT_PUBLIC_*` values are inlined into the client bundle
# at BUILD time. Adding or changing one requires a NEW deployment;
# editing the variable alone does not affect the live site. Redeploy
# (or push a commit) after changing it.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Convex deployment URL (your `.convex.cloud` deployment).
# Get it from `npx convex dev` output. Must also be set in the Convex
# dashboard as `RESEND_API_KEY` (see below) for password reset to work.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# REQUIRED — the deployment's site URL. The Convex backend publishes its
# JWKS here (`<site>/auth/jwks`) and the access tokens it verifies are
# issued against this issuer. It must match the `iss` claim of every
# token, so it has to be the URL the browser actually talks to.
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# REQUIRED — Secret used to sign the session cookie (min 32 chars).
# Generate with:  openssl rand -base64 48
# On Vercel, store this one as a Secret so it cannot be read back.
SESSION_SECRET=

# REQUIRED (Phase 2) — the shared secret between the Next.js server and the
# Convex deployment. It gates the operations a browser must never reach:
# opening a session, reading a password-reset code, emailing a verification
# code. Must be at least 16 characters and MUST be set on BOTH sides —
# in this file and in the Convex dashboard's environment variables.
#
# If it is not configured, those operations stay CLOSED rather than opening
# to anyone who sends an empty string.
#
# Generate with:  openssl rand -base64 48
SMARTBUZ_SERVER_SECRET=

# REQUIRED — RSA private key (PKCS#8 DER, base64url) used to sign the
# short-lived access tokens the Convex backend verifies.
# Generate with:  node scripts/generate-auth-keys.mjs
# The matching PUBLIC key lives in convex/authJwks.ts and is published by
# the deployment — it is not a secret. Never commit this value.
SMARTBUZ_JWT_PRIVATE_KEY=

# REQUIRED for password reset by email — Resend API key.
# https://resend.com  →  Create API key
# Also used as the fallback server secret when SMARTBUZ_SERVER_SECRET is
# not set — set SMARTBUZ_SERVER_SECRET explicitly in production.
RESEND_API_KEY=

# OPTIONAL — Sender address for password reset and verification emails.
RESEND_FROM_EMAIL=noreply@smartbuz.app

# OPTIONAL — Mobile money gateway credentials.
# Without these, /api/momo returns a simulated response and does NOT
# collect money. See AUDIT.md §3.7.
MTN_MOMO_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
