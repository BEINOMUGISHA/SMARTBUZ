# ─────────────────────────────────────────────────────────────
# SMART_BUZ — Environment Variables
# Copy to `.env.local` for development. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────
#
# Production (Vercel): set these under
#   Project → Settings → Environment Variables
# and enable them for Production, Preview and Development.
#
# IMPORTANT — `NEXT_PUBLIC_*` values are inlined into the client bundle
# at BUILD time. Adding or changing one requires a NEW deployment;
# editing the variable alone does not affect the live site. Redeploy
# (or push a commit) after changing it.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Convex deployment URL (your `.convex.cloud` deployment).
# Get it from `npx convex dev` output. Must also be set in the Convex
# dashboard as `RESEND_API_KEY` (see below) for password reset to work.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# REQUIRED — Secret used to sign the session cookie (min 32 chars).
# Generate with:  openssl rand -base64 48
# On Vercel, store this one as a Secret so it cannot be read back.
SESSION_SECRET=

# REQUIRED for password reset by email — Resend API key.
# https://resend.com  →  Create API key
RESEND_API_KEY=

# OPTIONAL — Sender address for password reset emails.
RESEND_FROM_EMAIL=noreply@smartbuz.app

# OPTIONAL — Mobile money gateway credentials.
# Without these, /api/momo returns a simulated response and does NOT
# collect money. See AUDIT.md §3.7.
MTN_MOMO_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
