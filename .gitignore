# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test-build/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
gg
.vercel

# typescript
*.tsbuildinfo
h
next-env.d.ts
# deploy3

# local tooling artefacts
.next-dev.log
scripts/fixtures/export/
scripts/fixtures/*.zip

# The scratch directory the QA audit kept its raw output in, and the test
# log. Neither belongs in the repository: the first is a large machine
# report and the second is overwritten on every run.
.qa-audit/
.test-out.txt

# One-off codemods and scratch files kept while a fix was being made. They
# are not part of the application and are not worth keeping once the work
# they did is committed.
.scratch/

# The scratch scripts and the notes they wrote while a piece of work was in
# progress. They are one-offs, they are full of absolute paths to this
# machine, and they must never reach the repository.
scripts/_tmp-*

# What a local run leaves behind: fetched pages, recovered dictionary dumps,
# the dev server log, and the scratch Chrome profile used to look at the app.
.page-*.html
.recover-*
.restore-report.json
.gap-report.txt
.en-before*.ts
.en-run*.ts
.en-idem-*.ts
.groups.txt
.cookies.txt
.dev-run.log
.build.log
.lint.log
.tmp-chrome*
.tmp-shots*/
.tmp-sweep*.log

# The per-language copies of the recovered words. The combined file,
# 00-recovered.json, is the one the merge reads; these three are empty
# placeholders left behind when the merge was given a single combined batch.
scripts/i18n-batches/*-recovered.json
!scripts/i18n-batches/00-recovered.json
